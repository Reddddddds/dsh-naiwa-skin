{
  "name": "dsh-naiwa-skin",
  "version": "0.2.0",
  "description": "奶娃皮肤：DeepSeek Harness web 界面的可插拔皮肤插件 —— 通过主题系统注册独立的 naiwa-light/naiwa-dark 主题（不修改默认皮肤），内置设置开关，卸载即回默认。A pluggable Naiwa skin for the DSH web UI: standalone registered themes, settings toggle, default skin stays untouched.",
  "type": "module",
  "license": "MIT",
  "author": "Reddddddds",
  "homepage": "https://github.com/Reddddddds/dsh-naiwa-skin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reddddddds/dsh-naiwa-skin.git"
  },
  "bugs": {
    "url": "https://github.com/Reddddddds/dsh-naiwa-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "naiwa",
    "奶娃",
    "cute"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  }
}
